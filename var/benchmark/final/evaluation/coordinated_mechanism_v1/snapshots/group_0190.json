    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный правовой акт, регулирующий порядок разработки и реализации государственных программ РФ (в части планирования показателей)."
      },
      {
        "id": "A2",
        "need": "Выявить конкретную статью или пункт, регламентирующий правила помесячного планирования значений показателей государственной (комплексной) программы."
      },
      {
        "id": "A3",
        "need": "Найти исчерпывающий перечень (6 случаев) оснований, при которых не осуществляется помесячное планирование показателей."
      },
      {
        "id": "A4",
        "need": "Уточнить, относится ли требование к комплексным программам отдельно или они приравнены к государственным программам в данном контексте."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений или особых условий для федеральных целевых программ (если они рассматриваются в том же акте)."
      }
    ],
