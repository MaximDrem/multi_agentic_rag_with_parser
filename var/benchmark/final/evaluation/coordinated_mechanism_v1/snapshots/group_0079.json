  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативно-правовую базу, регулирующую работу Системы межведомственного электронного взаимодействия (СМЭВ) и Системы межведомственного электронного взаимодействия органов государственной власти субъектов РФ (СВПО). Ключевой документ: Постановление Правительства РФ от 08.11.2011 № 913 (или его актуальные редакции/замены, например, в контексте ФИС ЕПГУ или новых систем). Также проверить наличие специфических регламентов для СВПО конкретного субъекта РФ, если вопрос подразумевает региональный контекст, но обычно речь идет о федеральных стандартах."
      },
      {
        "id": "A2",
        "need": "Выявить требования к режиму работы (времени доступности, частоте обновлений, времени отклика) при подаче запросов и предоставлении ответов. Ищутся формулировки типа 'в режиме реального времени', 'в автоматическом режиме', 'круглосуточно', 'в рабочие часы' или спецификации SLA (Service Level Agreement)."
      },
      {
        "id": "A3",
        "need": "Определить технические и организационные условия обеспечения этого режима. Это включает требования к протоколам обмена (SOAP, REST, XML), шифрованию, аутентификации и наличию резервных каналов связи, если они регламентируются как часть 'режима'."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или ограничений по режиму работы (например, технические работы, сбои, нерабочие дни), которые могут влиять на предоставление ответов."
      },
      {
        "id": "A5",
        "need": "Установить, кто является оператором или администратором СВПО (федеральный орган, региональный оператор) и какие документы он издает для регламентации режима работы."
      }
    ],
    "assignments": {
      "bm25": [
        "Постановление Правительства РФ № 913",
        "СВПО"
      ],
      "dense": [
        "режим работы системы межведомственного электронного взаимодействия",
        "время предоставления ответов в СВПО"
      ]
    }
  },
