  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить субъект ответственности за обработку автоинцидентов (автоматически выявленных инцидентов безопасности), которые не входят в зону ответственности ВПО (Ведомственной подсистемы обработки или аналогичного компонента, в зависимости от контекста ИБ-архитектуры)."
      },
      {
        "id": "A2",
        "need": "Выявить нормативный документ, содержащий 'Единый план' (вероятно, Единый план мероприятий по обеспечению информационной безопасности или аналогичный документ регулятора, например, ФСТЭК или ФСБ России)."
      },
      {
        "id": "A3",
        "need": "Определить разграничение полномочий между ВПО и другими субъектами (например, Оператором ИС, Администратором безопасности, ЦОИБ) в части обработки инцидентов."
      },
      {
        "id": "A4",
        "need": "Установить, какие именно показатели и мероприятия Единого плана относятся к категории 'не обрабатываемых ВПО' и кто является исполнителем для них."
      },
      {
        "id": "A5",
        "need": "Проверить наличие определений терминов 'ВПО', 'автоинциденты', 'Единый план' в рассматриваемых нормативных актах РФ."
      }
    ],
    "assignments": {
      "bm25": [
        "Единый план мероприятий",
        "ВПО"
      ],
      "dense": [
        "разграничение ответственности за обработку инцидентов информационной безопасности",
        "кто обрабатывает инциденты не входящие в компетенцию ВПО"
      ]
    }
  },
