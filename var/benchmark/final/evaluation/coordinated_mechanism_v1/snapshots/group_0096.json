  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный правовой акт, регулирующий деятельность в сфере СВПО (Системы предупреждения и ликвидации чрезвычайных ситуаций / Системы взаимодействия органов власти и организаций по обеспечению безопасности), в котором упоминаются межведомственные рабочие группы (МРГ)."
      },
      {
        "id": "A2",
        "need": "Выявить субъект (орган власти, должностное лицо или организацию), уполномоченный формировать указанные МРГ."
      },
      {
        "id": "A3",
        "need": "Уточнить состав или порядок формирования МРГ, если он регламентирован (например, по представлению каких ведомств)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых случаев формирования МРГ для проработки проблем в СВПО."
      }
    ],
