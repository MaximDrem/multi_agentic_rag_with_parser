  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регламентирующий методику расчёта уровня достижения показателей (например, в рамках госпрограмм, стратегий или KPI). Часто это Приказы Минэкономразвития или отраслевые регламенты."
      },
      {
        "id": "A2",
        "need": "Найти формулу или методическое указание, определяющее значение индикатора X (коэффициента направления изменения) для двух случаев: когда показатель возрастает (положительная динамика) и когда убывает (отрицательная динамика)."
      },
      {
        "id": "A3",
        "need": "Уточнить, является ли X бинарной величиной (например, +1 и -1) или процентным коэффициентом, и как он применяется в формуле расчёта уровня достижения (умножается, делится или используется как поправочный множитель)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых случаев (например, нулевые значения, отрицательные базовые значения), влияющих на выбор значения X."
      }
    ],
    "assignments": {
      "bm25": [
        "Приказ Минэкономразвития России",
        "индикатор X"
      ],
      "dense": [
        "методика расчёта уровня достижения показателей госпрограмм",
        "индикатор возрастания убывания X формула"
      ]
    }
  },
