  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий создание автоинцидентов (автоматических инцидентов) в рамках нацпроектов или региональных проектов (например, Постановление Правительства РФ о нацпроектах или регламенты Минэкономразвития/Минцифры)."
      },
      {
        "id": "A2",
        "need": "Выявить конкретное условие, при котором фиксируется 'несвоевременное достижение КТ' (ключевой точки) регионального проекта. Обычно это связано с просрочкой сроков, установленных дорожной картой или планом-графиком."
      },
      {
        "id": "A3",
        "need": "Определить, кто является субъектом, создающим автоинцидент (автоматизированная система, куратор проекта, региональный оператор)."
      },
      {
        "id": "A4",
        "need": "Уточнить, какие именно КТ (ключевые точки) подлежат контролю в контексте создания инцидентов (финансовые, физические, управленческие)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений или оснований для отмены/блокировки автоинцидента (например, форс-мажор, изменение сроков по решению куратора)."
      }
    ],
    "assignments": {
      "bm25": [
        "Постановление Правительства РФ от 03.06.2021 N 908 \"О федеральном проекте...\"",
        "регламент создания инцидентов"
      ],
      "dense": [
        "условия создания автоинцидентов при просрочке ключевых точек регионального проекта",
        "автоматическое формирование инцидентов по нацпроектам при невыполнении сроков"
      ]
    }
  },
