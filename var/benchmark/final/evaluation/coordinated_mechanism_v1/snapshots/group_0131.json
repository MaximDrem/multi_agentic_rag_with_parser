  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий процесс управления автоинцидентами в сфере финансовых рынков (КТ ФП, КТ РП). Обычно это внутренние регламенты брокеров/дилеров или требования ЦБ РФ к организаторам торговли/участникам рынка."
      },
      {
        "id": "A2",
        "need": "Выявить требования к периодичности уведомлений менеджеров инцидентов координаторам о результатах процесса управления автоинцидентами (фактические результаты, статусы, закрытие инцидентов)."
      },
      {
        "id": "A3",
        "need": "Выявить требования к периодичности предоставления отчетов по показателям (KPI, метрики эффективности, статистика инцидентов) в рамках того же процесса."
      },
      {
        "id": "A4",
        "need": "Определить, различаются ли периодичности для 'результатов процесса' и 'показателей', и если да, то какие именно интервалы установлены (ежедневно, еженедельно, ежемесячно, по факту)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений или особых условий (например, при критических инцидентах, изменении законодательства, внутренних аудитах)."
      }
    ],
    "assignments": {
      "bm25": [
        "автоинциденты",
        "КТ ФП"
      ],
      "dense": [
        "периодичность уведомлений менеджеров инцидентов координаторам автоинцидентов КТ ФП КТ РП",
        "отчетность по результатам управления автоинцидентами финансовые рынки"
      ]
    }
  },
