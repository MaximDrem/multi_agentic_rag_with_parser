  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить, применяется ли к региональным проектам, входящим в состав национальных проектов или государственных программ, механизм расчета уровня достижения, исключающий или включающий параметры с нулевым плановым значением."
      },
      {
        "id": "A2",
        "need": "Выявить нормативные акты, регулирующие порядок мониторинга и оценки эффективности реализации региональных проектов в системе ГАС Управление (в частности, Приказы Минэкономразвития РФ, регламентирующие работу с индикаторами и показателями)."
      },
      {
        "id": "A3",
        "need": "Определить, является ли нулевое плановое значение параметра основанием для исключения этого параметра из расчета агрегированного уровня достижения или для его обнуления в итоговой оценке."
      },
      {
        "id": "A4",
        "need": "Найти разъяснения или методические рекомендации Минэкономразвития РФ или Правительства РФ по интерпретации показателей с нулевыми значениями в контексте мониторинга нацпроектов."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений для конкретных типов региональных проектов (например, инфраструктурные, социальные), где могут действовать особые правила учета нулевых планов."
      }
    ],
    "assignments": {
      "bm25": [
        "Приказ Минэкономразвития России от 29.09.2020 N 680",
        "Постановление Правительства РФ от 26.07.2019 N 937"
      ],
      "dense": [
        "методика расчета уровня достижения региональных проектов нулевое плановое значение",
        "учет параметров с нулевым значением в мониторинге нацпроектов ГАС Управление"
      ]
    }
