    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий порядок оценки достижения параметров (KPI, плановых показателей, целевых индикаторов), в котором содержится правило приравнивания значений, превышающих 100%, или отрицательных значений."
      },
      {
        "id": "A2",
        "need": "Выявить конкретную формулировку или правило: чему именно приравнивается значение (например, 100%, 0, максимальное возможное значение, или же такие случаи не допускаются/рассматриваются отдельно)."
      },
      {
        "id": "A3",
        "need": "Определить контекст применения: относится ли это правило к государственному управлению, корпоративному управлению, бюджетному процессу или частным договорным отношениям."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или специальных условий для различных типов параметров (например, финансовые vs нефинансовые показатели)."
      }
    ],
