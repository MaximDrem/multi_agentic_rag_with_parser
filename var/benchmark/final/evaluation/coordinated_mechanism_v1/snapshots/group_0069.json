  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий деятельность проектных комитетов (ПК) в РФ (например, Постановление Правительства РФ № 1096 или региональные акты, если контекст не указан, но чаще всего речь о федеральных ПК). Найти статью или пункт, регламентирующий процедуру подготовки к заседанию ПК."
      },
      {
        "id": "A2",
        "need": "Выявить конкретное количество рабочих дней, за которое ответственный секретарь обязан направить членам ПК повестку дня, приглашение и материалы."
      },
      {
        "id": "A3",
        "need": "Проверить наличие исключений или особых случаев (например, экстренные заседания), когда сроки могут быть сокращены."
      },
      {
        "id": "A4",
        "need": "Уточнить состав направляемых документов: повестка, письмо-приглашение, комплект материалов."
      }
    ],
    "assignments": {
