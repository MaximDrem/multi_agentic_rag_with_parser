  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определение и перечень принципов разработки и реализации государственных программ в соответствии с действующим законодательством РФ."
      },
      {
        "id": "A2",
        "need": "Нормативный правовой акт, устанавливающий порядок разработки, реализации и оценки эффективности государственных программ (в т.ч. перечень принципов)."
      },
      {
        "id": "A3",
        "need": "Связанные нормы: положения о федеральных государственных программах, региональных государственных программах, если они регулируются отдельными актами или ссылками на общий порядок."
      },
      {
        "id": "A4",
        "need": "Условия применения принципов: для каких уровней власти (федеральный, региональный, муниципальный) они обязательны."
      },
      {
        "id": "A5",
        "need": "Исключения или особые случаи: программы, не подпадающие под общий порядок (например, целевые программы в отдельных сферах, если есть специфика)."
      },
      {
        "id": "A6",
        "need": "Даты: актуальная редакция нормативного акта, определяющего принципы (чтобы исключить утратившие силу положения)."
      }
    ],
