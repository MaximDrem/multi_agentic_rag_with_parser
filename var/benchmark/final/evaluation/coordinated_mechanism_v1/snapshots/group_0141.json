  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий формирование объектов типа 'автоинцидент' (например, в сфере страхования, логистики или контроля качества). Проверить наличие понятия 'суток ожидания' и порядка его учета."
      },
      {
        "id": "A2",
        "need": "Установить точный алгоритм расчета срока: является ли 'плановый срок' началом отсчета, как 'суток ожидания' влияет на смещение даты, и через сколько дней после этого смещенного срока происходит автоматическое формирование объекта."
      },
      {
        "id": "A3",
        "need": "Выявить условия, при которых информация о достижении параметра считается 'не поступившей' (отсутствие отчета, таймаут связи, статус 'не подтверждено')."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых случаев, когда формирование автоинцидента откладывается или не происходит вовсе (например, наличие предварительного уведомления, форс-мажор)."
      }
    ],
    "assignments": {
      "bm25": [
        "автоинцидент",
        "плановый срок"
      ],
      "dense": [
        "алгоритм формирования автоинцидента после планового срока",
        "учет суток ожидания при расчете срока инцидента"
      ]
    }
  },
