  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий порядок формирования и изменения Единого плана (государственных заданий/программ), в частности, процедуру внесения изменений в утверждаемую часть."
      },
      {
        "id": "A2",
        "need": "Установить, является ли Минэкономразвития России уполномоченным органом, принимающим или анализирующим предложения по изменению Единого плана, или это функция других министерств/ведомств."
      },
      {
        "id": "A3",
        "need": "Найти конкретный срок (количество рабочих/календарных дней), в течение которого уполномоченный орган рассматривает и анализирует предложение об изменении утверждаемой части Единого плана."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых процедур для разных видов изменений (например, изменение объема финансирования vs изменение перечня мероприятий)."
      }
    ],
