  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный правовой акт, содержащий Временный регламент обработки инцидентов, связанных с недостижением параметров Единого плана (вероятно, Единого плана газификации или другого отраслевого плана, требуется уточнение контекста 'Единого плана')."
      },
      {
        "id": "A2",
        "need": "Установить орган государственной власти или должностное лицо, уполномоченное утверждать данный регламент (например, Минэнерго, Правительство РФ, Роскомнадзор и т.д., в зависимости от сферы 'Единого плана')."
      },
      {
        "id": "A3",
        "need": "Определить дату утверждения регламента (дата издания приказа, постановления или распоряжения)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие в документе формулировок о 'недостижении параметров Единого плана' и процедуре обработки таких инцидентов."
      },
      {
        "id": "A5",
        "need": "Выявить возможные исключения или особые условия применения регламента."
      }
    ],
    "assignments": {
      "bm25": [
        "Временный регламент обработки инцидентов",
        "Единый план"
      ],
      "dense": [
        "Временный регламент обработки инцидентов недостижение параметров Единого плана",
        "порядок реагирования на отклонения от Единого плана"
      ]
    }
  },
