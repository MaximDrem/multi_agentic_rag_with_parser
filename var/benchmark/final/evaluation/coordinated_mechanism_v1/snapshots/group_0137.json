  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить, к какому именно регламенту относится вопрос (название документа, номер, дата принятия), так как понятия могут различаться в зависимости от отрасли (например, ПДД, регламент ЦБ РФ, регламент оператора связи, внутренний регламент компании)."
      },
      {
        "id": "A2",
        "need": "Найти в тексте указанного регламента раздел «Определение терминов и понятий» или глоссарий."
      },
      {
        "id": "A3",
        "need": "Извлечь точное определение термина «инцидент» из регламента."
      },
      {
        "id": "A4",
        "need": "Извлечь точное определение термина «автоинцидент» (или «автомобильное происшествие», «ДТП», если термин «автоинцидент» не используется напрямую, а используется описательная конструкция) из регламента."
      },
      {
        "id": "A5",
        "need": "Сравнить извлеченные определения, выделив ключевые различия: субъектный состав (участники), объект воздействия (транспортное средство vs любой объект), последствия (материальный ущерб, угроза жизни и т.д.), контекст возникновения."
      },
      {
        "id": "A6",
        "need": "Проверить, есть ли в регламенте исключения или уточнения, когда «инцидент» может считаться «автоинцидентом» или наоборот."
      }
    ],
    "assignments": {
      "bm25": [
        "регламент",
        "определение терминов"
      ],
      "dense": [
        "сравнение определений инцидента и автоинцидента в регламенте",
        "различие понятий инцидент и дорожно-транспортное происшествие в нормативном акте"
      ]
    }
  },
