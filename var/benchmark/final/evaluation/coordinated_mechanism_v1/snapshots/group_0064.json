  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий деятельность проектных комитетов в РФ (например, Постановление Правительства РФ № 1062 или региональные акты, если контекст не указан, но чаще всего речь о федеральных проектных комитетах при Правительстве РФ или в рамках нацпроектов). Проверить наличие требования к периодичности актуализации плана-графика."
      },
      {
        "id": "A2",
        "need": "Выявить конкретную формулировку о периодичности: 'ежеквартально', 'ежемесячно', 'по мере необходимости', 'раз в полгода' или иное. Проверить, является ли это обязательным требованием или рекомендательным."
      },
      {
        "id": "A3",
        "need": "Проверить, есть ли исключения или особые условия для актуализации (например, при изменении состава комитета, изменении сроков реализации проекта, изменении полномочий)."
      },
      {
        "id": "A4",
        "need": "Установить, кто уполномочен проводить актуализацию (секретариат, председатель, члены комитета) и в какой срок после принятия решения об изменении план-график должен быть обновлен документ."
      }
    ],
    "assignments": {
      "bm25": [
        "Постановление Правительства РФ от 14.06.2013 № 506",
        "Постановление Правительства РФ от 15.04.2021 № 601"
      ],
      "dense": [
        "периодичность актуализации плана-графика заседаний проектного комитета",
        "как часто обновляется план-график проектного комитета"
      ]
    }
  },
