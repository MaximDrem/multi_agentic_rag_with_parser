  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регламентирующий расчет УД (удельных показателей) по НП (нормативным показателям/нормативам) в системе ГАС Управление (АРМ Аналитика РП). Обычно это Приказы Минфина или ФНС, либо внутренние регламенты ФНС России."
      },
      {
        "id": "A2",
        "need": "Выявить перечень показателей, которые включаются в формулу расчета УД, чтобы методом исключения определить те, которые не участвуют."
      },
      {
        "id": "A3",
        "need": "Проверить наличие исключений или специфических правил для АРМ Аналитика РП (Руководителя Подразделения) в ГАС Управление, касающихся фильтрации данных."
      },
      {
        "id": "A4",
        "need": "Уточнить, что означает аббревиатура 'УД' в данном контексте (например, удельный вес доходов, удельные затраты, индекс эффективности) и 'НП' (нормативные показатели, налоговые платежи)."
      }
    ],
    "assignments": {
      "bm25": [
        "ГАС Управление",
        "АРМ Аналитика РП"
      ],
      "dense": [
        "показатели не участвующие в расчете удельных показателей ГАС Управление",
        "исключаемые показатели при расчете нормативов АРМ Аналитика РП"
      ]
    }
  },
