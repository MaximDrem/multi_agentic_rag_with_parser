  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить механизм эскалации проблем, не решенных в рамках Межведомственной рабочей группы (МРГ). Требуется найти нормативный акт, регламентирующий порядок передачи unresolved issues на более высокий уровень управления (например, в Координационный совет, Правительственную комиссию или профильного министра/руководителя органа исполнительной власти)."
      },
      {
        "id": "A2",
        "need": "Выявить конкретный орган или должностное лицо, которому передаются такие проблемы. Это может быть Координационный совет при Правительстве РФ, профильная министерская коллегия, или непосредственно руководитель федерального органа исполнительной власти."
      },
      {
        "id": "A3",
        "need": "Определить критерии и условия передачи проблемы на более высокий уровень (например, отсутствие решения в течение X дней, необходимость изменения законодательства, межведомственный характер, требующий участия нескольких министерств)."
      },
      {
        "id": "A4",
        "need": "Найти ссылки на конкретные нормативные правовые акты (постановления Правительства РФ, распоряжения, регламенты), в которых описан данный процесс эскалации."
      }
    ],
    "assignments": {
      "bm25": [
        "Межведомственная рабочая группа",
        "МРГ"
      ],
      "dense": [
        "механизм эскалации проблем межведомственной рабочей группы",
        "порядок передачи вопросов не решенных в рамках МРГ"
      ]
