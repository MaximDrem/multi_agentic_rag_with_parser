  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный правовой акт, устанавливающий порядок мониторинга реализации документов стратегического планирования в сфере национальной безопасности."
      },
      {
        "id": "A2",
        "need": "Выявить конкретный документ (отчет, доклад, заключение), который является итоговым или основным результатом такого мониторинга согласно законодательству РФ."
      },
      {
        "id": "A3",
        "need": "Установить орган государственной власти, уполномоченный проводить данный мониторинг и формировать указанный документ."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или специальных процедур для сферы национальной безопасности по сравнению с общим стратегическим планированием."
      }
    ],
