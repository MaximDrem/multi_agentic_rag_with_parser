  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий деятельность проектных комитетов (ПК) в контексте государственного управления или крупного корпоративного управления (например, Роскосмос, Росатом, Минцифры или типовые регламенты). Уточнить, кто является 'куратором' в данном контексте (заместитель руководителя, министр и т.д.)."
      },
      {
        "id": "A2",
        "need": "Найти конкретную норму, устанавливающую временной интервал между принятием решения куратором и возможностью назначения выездного заседания ПК. Проверить наличие формулировок 'не ранее чем через', 'в течение', 'срок ожидания'."
      },
      {
        "id": "A3",
        "need": "Выявить исключения или особые случаи, когда выездное заседание может быть назначено раньше установленного срока (например, по инициативе председателя ПК, при форс-мажоре или срочных вопросах)."
      },
      {
        "id": "A4",
        "need": "Определить, что понимается под 'принятием решения куратором' (дата подписания, дата уведомления, дата публикации) для отсчета срока."
      }
    ],
    "assignments": {
      "bm25": [
        "проектный комитет",
        "выездное заседание"
      ],
      "dense": [
        "срок назначения выездного заседания проектного комитета после решения куратора",
        "когда можно провести выездное заседание ПК после согласования"
      ]
    }
  },
