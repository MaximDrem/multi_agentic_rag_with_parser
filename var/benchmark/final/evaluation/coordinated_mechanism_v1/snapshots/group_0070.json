  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативно-правовую базу, регулирующую деятельность проектных комитетов в РФ (например, Постановление Правительства РФ № 1231, отраслевые регламенты, внутренние положения компаний). Уточнить, что 'проектный комитет' не является универсальным государственным органом, а его статус зависит от контекста (госзаказ, корпоративное управление, госкорпорации)."
      },
      {
        "id": "A2",
        "need": "Выявить требования к процедуре принятия решений в очной форме: кворум, порядок голосования, фиксация результатов (протокол)."
      },
      {
        "id": "A3",
        "need": "Определить механизм разрешения ситуации равенства голосов: наличие у председателя права решающего голоса, процедура повторного голосования или передача вопроса на высший уровень принятия решений."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или специальных правил для конкретных типов проектных комитетов (например, в сфере оборонзаказа, госкорпораций 'Росатом', 'Роскосмос' или в рамках нацпроектов)."
      }
    ],
    "assignments": {
