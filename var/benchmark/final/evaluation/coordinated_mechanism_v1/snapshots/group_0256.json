  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативное понятие 'УД' (удаленная диагностика, управление дистанционное, учетная запись, уголовно-деловая?) в контексте 'НП' (некоммерческая организация, нормативный правовой акт, низковольтное оборудование, нанопрепарат?). Без уточнения аббревиатур вопрос юридически некорректен."
      },
      {
        "id": "A2",
        "need": "Если 'УД' = 'Удаленная диагностика' (IT/медицина), а 'НП' = 'Некоммерческая организация': искать сроки фиксации результатов диагностики в учетной системе НКО. Регулируется ФЗ-152 (персданные), ФЗ-323 (медицина) или отраслевыми приказами."
      },
      {
        "id": "A3",
        "need": "Если 'УД' = 'Учетная запись' (цифровые сервисы), а 'НП' = 'Некоммерческая организация': искать сроки фиксации создания/изменения учетной записи в ЕГРЮЛ или на госпортале (Госуслуги). Регулируется ФЗ-129, ФЗ-8, Постановлениями Правительства о порядке ведения реестров."
      },
      {
        "id": "A4",
        "need": "Если 'УД' = 'Уголовное дело', а 'НП' = 'Низковольтное оборудование' (маловероятно) или 'НП' = 'Нормативный правовой акт': искать сроки фиксации возбуждения УД. Регулируется УПК РФ (ст. 144, 145)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие специфических отраслевых терминов 'УД' и 'НП' в законодательстве РФ (например, в сфере ЖКХ, строительства, IT). 'НП' может означать 'Нормативный Правовой акт', тогда вопрос о сроках фиксации УД в НП."
      }
    ],
    "assignments": {
      "bm25": [
        "УД",
