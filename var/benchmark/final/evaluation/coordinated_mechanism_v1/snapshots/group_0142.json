  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий порядок регистрации и классификации автоинцидентов в системе ЕАИСТО (или аналогичной информационной системе)."
      },
      {
        "id": "A2",
        "need": "Выявить субъектов, обязанных вносить изменения: ответственные работники ВПО (высших профессиональных образовательных учреждений), СП ФОИВ (структурных подразделений федеральных органов исполнительной власти), РПО (региональных программных операторов или региональных органов)."
      },
      {
        "id": "A3",
        "need": "Найти конкретный срок (количество дней/часов) для внесения изменений в классификационный признак автоинцидента с момента его регистрации."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых процедур для разных типов автоинцидентов (например, с пострадавшими, без пострадавших, с материальным ущербом)."
      },
      {
        "id": "A5",
        "need": "Установить, что понимается под 'классификационным признаком автоинцидента' в контексте данного нормативного акта."
      }
    ],
    "assignments": {
      "bm25": [
        "Федеральный закон от 21.04.2011 N 6-ФЗ 'О внесении изменений в отдельные законодательные акты Российской Федерации в части совершенствования порядка регистрации транспортных средств и учета транспортных средств'",
        "Приказ Минтранса России от 28.06.2013 N 199 'Об утверждении Порядка ведения государственного реестра транспортных средств и учета транспортных средств'"
      ],
      "dense": [
        "срок внесения изменений в классификационный признак автоинцидента",
        "обязанности ответственных работников ВПО СП ФОИВ РПО по обновлению данных об автоинциденте"
      ]
    }
  },
