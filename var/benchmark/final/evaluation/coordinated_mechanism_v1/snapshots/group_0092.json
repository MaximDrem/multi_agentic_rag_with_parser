  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный правовой акт, регулирующий деятельность Системы предупреждения и ликвидации чрезвычайных ситуаций (СВПО) в РФ, и найти разделы, касающиеся организационной структуры и функциональных обязанностей подразделений."
      },
      {
        "id": "A2",
        "need": "Идентифицировать конкретный орган или структуру, именуемую 'Аналитический центр' в контексте СВПО (например, Аналитический центр МЧС России или аналогичная структура в составе других ведомств), и найти положения о его статусе."
      },
      {
        "id": "A3",
        "need": "Выявить перечень должностных ролей, функций или обязанностей, закрепленных за сотрудниками данного Аналитического центра в рамках системы СВПО (например, анализ рисков, прогнозирование, подготовка аналитических записок)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или специфических условий применения данных ролей в различных типах чрезвычайных ситуаций или на разных этапах (предупреждение, ликвидация)."
      },
      {
        "id": "A5",
        "need": "Найти ссылки на смежные нормативные акты, определяющие взаимодействие Аналитического центра с другими субъектами СВПО (федеральные органы исполнительной власти, субъекты РФ)."
      }
    ],
    "assignments": {
