  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативно-правовую базу, регулирующую создание и деятельность проектных комитетов в РФ (например, в рамках нацпроектов, госпрограмм или корпоративного управления)."
      },
      {
        "id": "A2",
        "need": "Выявить субъект (орган власти или организацию), уполномоченный формировать проектный комитет, и его полномочия по назначению членов."
      },
      {
        "id": "A3",
        "need": "Определить критерии отбора и требования к кандидатам (квалификация, должность, отсутствие конфликта интересов) для включения в состав проектного комитета."
      },
      {
        "id": "A4",
        "need": "Установить процедуру формирования состава: порядок назначения, утверждения, изменения и исключения членов комитета."
      },
      {
        "id": "A5",
        "need": "Выявить структуру проектного комитета (председатель, члены, секретарь) и соотношение представителей различных ведомств или структурных подразделений."
      },
      {
        "id": "A6",
        "need": "Определить сроки полномочий членов проектного комитета и условия их досрочного прекращения."
      }
    ],
