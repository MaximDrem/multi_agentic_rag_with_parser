  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий порядок обмена сообщениями об инцидентах информационной безопасности (ИБ) в РФ (например, Приказы ФСТЭК или ФСБ)."
      },
      {
        "id": "A2",
        "need": "Найти в нормативном документе классификацию срочности сообщений об инцидентах (высокая, стандартная, низкая) или уровни реагирования."
      },
      {
        "id": "A3",
        "need": "Выявить конкретные временные интервалы (контрольные сроки) для ответа или принятия мер по каждому из уровней срочности."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых условий применения этих сроков (например, для критической информационной инфраструктуры - КИИ)."
      }
    ],
    "assignments": {
      "bm25": [
        "Приказ ФСТЭК России",
        "Приказ ФСБ России"
      ],
      "dense": [
        "сроки реагирования на инциденты информационной безопасности",
        "классификация срочности сообщений об инцидентах"
      ]
    }
  },
