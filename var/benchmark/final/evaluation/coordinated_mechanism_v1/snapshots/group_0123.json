  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативные сроки создания запроса вида «Инцидент УДП» (Управление данными по потреблению) для показателей с помесячным планированием."
      },
      {
        "id": "A2",
        "need": "Выявить различия в датах создания запроса для периодов с января по ноябрь и для декабря (месяца закрытия года)."
      },
      {
        "id": "A3",
        "need": "Определить, какой орган или система (например, ЕИРЦ, АИС ГИС ЖКХ, операторы ИС) устанавливает эти сроки."
      },
      {
        "id": "A4",
        "need": "Найти ссылки на конкретные приказы, постановления или регламенты, регулирующие процесс формирования и передачи данных по потреблению (УДП)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений или особых условий для зимнего периода или месяцев, предшествующих закрытию года."
      }
    ],
    "assignments": {
      "bm25": [
        "Приказ Минстроя России от 29.07.2019 N 453/пр",
        "Постановление Правительства РФ от 31.08.2006 N 541"
      ],
      "dense": [
        "сроки создания запроса инцидент УДП помесячное планирование",
        "дата формирования запроса на передачу данных о потреблении"
      ]
    }
