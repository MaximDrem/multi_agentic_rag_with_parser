  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить понятие 'Федпроекты' (Федеральные проекты) в контексте нормативных правовых актов РФ. Установить, что это за объекты управления."
      },
      {
        "id": "A2",
        "need": "Выявить орган исполнительной власти или должностное лицо, ответственное за реализацию, контроль или курирование федеральных проектов. Часто это связано с Указами Президента РФ или Постановлениями Правительства РФ."
      },
      {
        "id": "A3",
        "need": "Определить механизм ответственности: кто является руководителем федерального проекта, кто осуществляет мониторинг, кто отчитывается."
      },
      {
        "id": "A4",
        "need": "Проверить наличие конкретных указов или распоряжений, где закреплено распределение полномочий по федеральным проектам (например, в рамках национальных проектов или госпрограмм)."
      }
    ],
