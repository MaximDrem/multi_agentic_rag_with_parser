  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий процесс создания автоинцидентов (например, в контексте ГИС ГМП, ФНС, Роскомнадзора или внутренних регламентов конкретных ведомств). Уточнить, что подразумевается под 'автоинцидентами' (автоматически создаваемые инциденты безопасности, нарушения, проверки и т.д.)."
      },
      {
        "id": "A2",
        "need": "Найти требования к периодичности формирования выгрузки данных для создания автоинцидентов (ежедневно, еженедельно, ежемесячно, в реальном времени и т.д.)."
      },
      {
        "id": "A3",
        "need": "Выявить конкретное время (часовой пояс, временное окно) или условия запуска процесса формирования выгрузки."
      },
      {
        "id": "A4",
        "need": "Определить орган, ответственный за формирование выгрузки или устанавливающий данные правила (Минцифры, ФНС, Роскомнадзор, внутренние регламенты оператора системы)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений или особых условий (например, при сбоях, праздничных днях, изменении объема данных)."
      }
    ],
    "assignments": {
      "bm25": [
        "автоинциденты",
        "очередная выгрузка"
      ],
      "dense": [
        "периодичность формирования выгрузки автоинцидентов",
        "время создания автоинцидентов регламент"
      ]
    }
  },
