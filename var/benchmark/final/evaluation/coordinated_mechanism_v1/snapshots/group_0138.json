  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить субъект ответственности (должность, роль, организацию) за обработку инцидентов информационной безопасности, связанных с параметрами РП (Резервное Программное обеспечение/Резервирование?) и РГП (Резервные Граничные Программы/Резервные Граничные Протоколы?). Требуется уточнить расшифровку аббревиатур РП и РГП в контексте нормативных актов РФ (вероятно, речь идет о критической информационной инфраструктуре - КИИ или персональных данных). Если РП/РГП относятся к конкретным техническим средствам защиты информации (ТСЗИ), необходимо найти требования к операционному персоналу или администраторам безопасности."
      },
      {
        "id": "A2",
        "need": "Выявить нормативные правовые акты РФ, регулирующие обработку инцидентов ИБ в контексте КИИ (ФЗ-187) или персональных данных (ФЗ-152), где могут фигурировать термины, схожие с РП и РГП, или требования к распределению ролей при реагировании на инциденты."
      },
      {
        "id": "A3",
        "need": "Проверить наличие приказов ФСТЭК или ФСБ России, устанавливающих состав организационных и технических мер, включая распределение обязанностей по мониторингу и реагированию на инциденты ИБ."
      },
      {
        "id": "A4",
        "need": "Определить, является ли 'по умолчанию' ответственность возложенной на оператора информационной системы, администратора безопасности или специализированную службу (СОКИБ/ЦСКИИ)."
      }
    ],
    "assignments": {
      "bm25": [
        "РП",
        "РГП"
      ],
      "dense": [
        "ответственный за обработку инцидентов информационной безопасности параметры РП РГП",
        "кто отвечает за реагирование на инциденты ИБ в КИИ"
      ]
    }
  },
