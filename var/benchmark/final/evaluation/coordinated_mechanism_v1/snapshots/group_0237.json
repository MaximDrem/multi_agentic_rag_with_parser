  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный срок (период) действия программно-плановых документов, разрабатываемых на этапе «планирование и программирование» в системе стратегического планирования РФ."
      },
      {
        "id": "A2",
        "need": "Идентифицировать конкретный вид программно-планового документа (например, программа социально-экономического развития, государственная программа, план мероприятий), к которому применяется данный срок."
      },
      {
        "id": "A3",
        "need": "Установить связь между сроком разработки программно-плановых документов и горизонтом планирования стратегических документов (Стратегия национальной безопасности, Указ Президента о национальных целях и т.д.)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых случаев для федеральных, региональных или муниципальных программно-плановых документов."
      },
      {
        "id": "A5",
        "need": "Найти упоминание этапа «планирование и программирование» в контексте законодательства о стратегическом планировании для подтверждения терминологической точности."
      }
    ],
    "assignments": {
      "bm25": [
        "Федеральный закон от 28.06.2014 N 172-ФЗ \"О стратегическом планировании в Российской Федерации\"",
        "программно-плановые документы"
      ],
      "dense": [
        "срок действия программно-плановых документов стратегическое планирование РФ",
        "горизонт планирования государственные программы социально-экономическое развитие"
      ]
    }
  },
