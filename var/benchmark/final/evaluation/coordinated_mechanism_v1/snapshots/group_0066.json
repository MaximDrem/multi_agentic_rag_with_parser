  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативно-правовые акты, регулирующие деятельность проектных комитетов (например, в сфере госзакупок, госпрограмм, нацпроектов или корпоративного управления), и выявить в них перечень допустимых форм проведения заседаний (очно, заочно, с использованием видеоконференцсвязи и т.д.)."
      },
      {
        "id": "A2",
        "need": "Установить, предусмотрены ли в указанных актах условия для проведения заседаний в заочной форме или с применением дистанционных технологий, и какие требования к кворуму или оформлению решений при этом предъявляются."
      },
      {
        "id": "A3",
        "need": "Проверить наличие исключений или ограничений на определенные формы проведения заседаний для конкретных видов проектных комитетов (например, проектные комитеты при Правительстве РФ, региональные проектные офисы)."
      }
    ],
