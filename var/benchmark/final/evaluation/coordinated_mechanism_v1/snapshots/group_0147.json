    "aspects": [
      {
        "id": "A1",
        "need": "Определить состав компонентов системы «Управление» (Системы управления дорожным движением и транспортом), ввод которых в эксплуатацию меняет порядок выявления автоинцидентов."
      },
      {
        "id": "A2",
        "need": "Выявить нормативный документ (регламент), устанавливающий правила выявления автоинцидентов средствами СВПО (системы видеонаблюдения и фото-видеофиксации) до ввода новых компонентов."
      },
      {
        "id": "A3",
        "need": "Определить момент или условие перехода от «старого» регламента к «новому» в зависимости от статуса компонентов системы «Управление»."
      },
      {
        "id": "A4",
        "need": "Уточнить, какие именно средства СВПО подпадают под действие старого регламента при отсутствии введенных компонентов системы «Управление»."
      }
    ],
