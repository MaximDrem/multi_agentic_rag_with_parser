  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить понятие 'брендирование объектов' в контексте российского законодательства (часто используется термин 'реклама', 'информирование', 'нанесение маркировки')."
      },
      {
        "id": "A2",
        "need": "Выявить федеральные законы, регулирующие рекламу и информационное сопровождение объектов (например, ФЗ 'О рекламе', ФЗ 'О связи', ФЗ 'О транспортной безопасности')."
      },
      {
        "id": "A3",
        "need": "Определить отраслевые нормативные акты для конкретных типов объектов (транспортные средства, здания, инфраструктура, цифровые платформы)."
      },
      {
        "id": "A4",
        "need": "Найти требования к согласованию брендирования с органами власти (администрации городов, Росавиация, Ространснадзор и т.д.)."
      },
      {
        "id": "A5",
        "need": "Выявить ограничения и запреты на брендирование (например, запрет на рекламу табака, алкоголя, или брендирование государственных учреждений)."
      },
      {
        "id": "A6",
        "need": "Определить роль ГОСТов и технических регламентов в вопросах внешнего вида и маркировки объектов."
      }
    ],
    "assignments": {
      "bm25": [
        "Федеральный закон \"О рекламе\"",
        "ФЗ-38"
      ],
      "dense": [
        "регламентация брендирования объектов в РФ",
        "законодательство о рекламе на объектах"
      ]
    }
  },
