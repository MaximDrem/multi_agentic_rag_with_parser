  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регламентирующий работу с параметрами ЕП (Единого параметра) или проектами в контексте автоинцидентов (например, в системах мониторинга, экологического контроля или управления рисками, таких как ЕПМ, ЕПР или внутренние регламенты Росприроднадзора/Минприроды)."
      },
      {
        "id": "A2",
        "need": "Найти спецификацию или справочник кодов статусов/действий для автоинцидентов, где указано значение кода, соответствующее 'решению об исключении' или 'завершении' параметра ЕП/проекта."
      },
      {
        "id": "A3",
        "need": "Проверить, является ли термин 'автоинцидент' и 'параметр ЕП' частью конкретного государственного информационного ресурса (ГИС) или корпоративной системы, и найти соответствующие технические регламенты или приказы."
      },
      {
        "id": "A4",
        "need": "Исключить возможность путаницы с кодами ОКВЭД, ОКПО или другими классификаторами, если термин 'ЕП' имеет иное значение в другом контексте (например, Единый налоговый счет)."
      }
    ],
    "assignments": {
      "bm25": [
        "код закрытия автоинцидента",
        "ЕП"
      ],
      "dense": [
        "код закрытия автоинцидента исключение параметра ЕП",
        "статус завершения проекта автоинцидент код"
      ]
    }
  },
