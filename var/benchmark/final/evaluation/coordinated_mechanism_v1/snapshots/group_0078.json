  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить минимальное количество сотрудников одного юридического лица (участника Системы), которые обязаны иметь доступ к Системе Взаимодействия с Потребителями (СВПО) в качестве пользователей."
      },
      {
        "id": "A2",
        "need": "Выявить нормативный документ, регулирующий порядок доступа к СВПО (например, Приказ ФНС России, регламентирующий работу с СВПО)."
      },
      {
        "id": "A3",
        "need": "Проверить наличие требований к количеству учетных записей или пользователей на одного участника (например, требование наличия хотя бы одного администратора или пользователя)."
      },
      {
        "id": "A4",
        "need": "Уточнить, распространяется ли требование на всех участников Системы или есть исключения (например, для ИП, не являющихся плательщиками НДС, или для новых участников в период тестирования)."
      }
    ],
    "assignments": {
      "bm25": [
        "Приказ ФНС России от 25.03.2021 N ED-7-26/228@",
        "СВПО"
      ],
      "dense": [
        "минимальное количество пользователей СВПО для участника",
        "требования к доступу к системе взаимодействия с потребителями"
      ]
    }
  },
