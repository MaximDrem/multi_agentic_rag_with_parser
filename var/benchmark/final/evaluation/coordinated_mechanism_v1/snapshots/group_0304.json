    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий планирование показателей проектов (вероятно, нацпроекты или госпрограммы РФ)."
      },
      {
        "id": "A2",
        "need": "Выявить требования к периодичности планирования показателей (ежемесячно, ежеквартально и т.д.)."
      },
      {
        "id": "A3",
        "need": "Найти исключения или случаи, когда ежемесячное планирование не требуется (например, специфика проекта, статус проекта, тип показателей)."
      },
      {
        "id": "A4",
        "need": "Определить орган, уполномоченный устанавливать такие исключения (Минэкономразвития, Правительство РФ и др.)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие изменений в законодательстве за последние 1-2 года, касающихся упрощения процедур планирования."
      }
    ],
