  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий порядок учета удорожания (УД) прокси-показателей в системе государственных закупок (44-ФЗ). Обычно это Положение о прокси-показателях, утвержденное Правительством РФ."
      },
      {
        "id": "A2",
        "need": "Выявить конкретные правила расчета и применения коэффициента удорожания (УД) для прокси-показателей. Включает ли это формулы, источники данных, периодичность обновления."
      },
      {
        "id": "A3",
        "need": "Определить роль и полномочия уполномоченного органа (ФАС России) в утверждении, изменении и размещении информации о прокси-показателях и их удорожании."
      },
      {
        "id": "A4",
        "need": "Установить, на какие виды закупок или контрактов распространяется учет УД прокси-показателей, и есть ли исключения."
      },
      {
        "id": "A5",
        "need": "Найти требования к документальному оформлению учета УД в документации о закупке и контракте."
      }
    ],
    "assignments": {
      "bm25": [
        "Постановление Правительства РФ от 31.12.2022 № 2495",
        "Федеральный закон № 44-ФЗ"
      ],
      "dense": [
        "порядок учета удорожания прокси-показателей в госзакупках",
        "как рассчитывается УД прокси-показателя"
      ]
    }
  },
