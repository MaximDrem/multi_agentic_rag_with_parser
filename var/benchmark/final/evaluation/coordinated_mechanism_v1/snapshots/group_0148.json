  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить, является ли термин 'автоинцидент' и код его закрытия частью федеральной нормативно-правовой базы РФ (законы, указы, постановления). Скорее всего, это внутренний корпоративный стандарт или регламент конкретной компании/системы (например, CRM, ITSM), а не законодательство."
      },
      {
        "id": "A2",
        "need": "Проверить наличие в законодательстве РФ понятий 'ЕП' (единый проект, единый портал, эквайринг?) и 'проект' в контексте обязательных сроков и кодов статусов закрытия инцидентов."
      },
      {
        "id": "A3",
        "need": "Если вопрос относится к специфической отрасли (например, госзакупки, IT-аутсорсинг в госсекторе), проверить наличие стандартов кодирования статусов в соответствующих регламентах (например, ГОСТы, отраслевые приказы Минцифры)."
      }
    ],
    "assignments": {
      "bm25": [
        "код закрытия автоинцидента",
        "ЕП/проект просрочка код"
      ],
      "dense": [
        "код закрытия инцидента просрочка выполнения проекта",
        "статус завершения задачи с нарушением сроков нормативное регулирование"
      ]
