  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить наличие и содержание перечня объектов (товаров, видов деятельности), подлежащих обязательному брендированию (маркировке) в РФ."
      },
      {
        "id": "A2",
        "need": "Идентифицировать нормативный правовой акт, устанавливающий требования к обязательному брендированию/маркировке."
      },
      {
        "id": "A3",
        "need": "Выявить орган государственной власти, уполномоченный вести реестр или утверждать перечни объектов брендирования."
      },
      {
        "id": "A4",
        "need": "Определить критерии отнесения объектов к категории подлежащих обязательному брендированию."
      },
      {
        "id": "A5",
        "need": "Выявить исключения из правила обязательного брендирования (объекты, не подлежащие маркировке)."
      },
      {
        "id": "A6",
        "need": "Установить даты вступления в силу требований о брендировании для различных категорий объектов."
      }
    ],
