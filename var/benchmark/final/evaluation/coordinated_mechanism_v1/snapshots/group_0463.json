  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить организационную структуру региональных проектных офисов (РПО) в рамках национального проекта «Малое и среднее предпринимательство и поддержка индивидуальной предпринимательской инициативы»."
      },
      {
        "id": "A2",
        "need": "Выявить нормативные акты, регулирующие деятельность РПО (постановления Правительства РФ, распоряжения, методические рекомендации Минэкономразвития)."
      },
      {
        "id": "A3",
        "need": "Определить, какой орган исполнительной власти субъекта РФ или какое должностное лицо несет ответственность за курирование, руководство или методическое сопровождение РПО."
      },
      {
        "id": "A4",
        "need": "Проверить наличие различий в курировании в зависимости от типа РПО (например, РПО при центрах «Мой бизнес», РПО при министерствах/департаментах экономики)."
      },
      {
        "id": "A5",
        "need": "Уточнить, является ли курирование прямым административным подчинением или методическим контролем со стороны федерального центра (Минэкономразвития России)."
      }
    ],
    "assignments": {
      "bm25": [
        "региональный проектный офис",
        "РПО"
      ],
      "dense": [
        "структура управления региональными проектными офисами малое предпринимательство",
        "кто руководит региональными проектными офисами по нацпроекту"
      ]
    }
  },
