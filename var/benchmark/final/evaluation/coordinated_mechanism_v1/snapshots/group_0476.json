    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативное требование к количеству контрольных точек в рамках комплекса процессных мероприятий. Уточнить, является ли это требование универсальным или зависит от конкретного вида мероприятия, отрасли или нормативного акта (например, ГОСТ, приказ Минэкономразвития, стандарт СРО)."
      },
      {
        "id": "A2",
        "need": "Выявить орган, устанавливающий данные требования (например, Минстрой, Минэкономразвития, Росстандарт, саморегулируемые организации)."
      },
      {
        "id": "A3",
        "need": "Определить контекст применения термина 'комплекс процессных мероприятий' (строительство, производство, экология, безопасность) и соответствующие ему нормативные документы."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых условий, при которых количество контрольных точек может отличаться от стандартного."
      }
