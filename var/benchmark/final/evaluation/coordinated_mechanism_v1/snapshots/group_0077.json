  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить юридическое или нормативное различие между терминами «проблема» и «инцидент» в контексте Системы управления охраной труда (СУОТ) или Системы управления промышленной безопасностью (СУПБ). Уточнить, является ли термин «проблема» официальным термином в ГОСТ Р ИСО 45001-2020 или ФНП, или это внутренний термин организации."
      },
      {
        "id": "A2",
        "need": "Найти определения термина «инцидент» в нормативных документах по охране труда (ГОСТ 12.0.003-2015, ГОСТ Р ИСО 45001-2020) и промышленной безопасности (Федеральные нормы и правила в области промышленной безопасности). Сравнить его с определением «несчастного случая» или «аварии»."
      },
      {
        "id": "A3",
        "need": "Проверить наличие термина «проблема» в качестве официального термина в ГОСТ Р ИСО 45001-2020 (вместо него используется «риск» или «возможность»). Если термин «проблема» не является нормативным, установить, в каких внутренних документах или методических рекомендациях он может использоваться в противопоставлении инциденту."
      },
      {
        "id": "A4",
        "need": "Выявить требования к расследованию и учету инцидентов (без несчастных случаев) согласно Трудовому кодексу РФ и приказам Минтруда. Сравить с процедурами выявления и устранения «проблем» (если они рассматриваются как несоответствия или риски)."
      }
    ],
    "assignments": {
      "bm25": [
        "ГОСТ Р ИСО 45001-2020",
        "Федеральный закон от 21.07.1997 N 116-ФЗ"
      ],
      "dense": [
        "различие между проблемой и инцидентом в СУОТ",
        "определение инцидента в охране труда и промышленной безопасности"
      ]
    }
  },
