  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регламентирующий методологию расчета удельных показателей (УД) в системе государственного планирования или бюджетного процесса РФ, где используется формула с учетом накопительного (нарастающего) итога."
      },
      {
        "id": "A2",
        "need": "Выявить точную формулу расчета удельного показателя, где знаменателем или числителем выступает значение, рассчитанное нарастающим итогом (например, объем выполненных работ, затраты, выбытие и т.д.)."
      },
      {
        "id": "A3",
        "need": "Определить контекст применения: является ли это требованием Минфина, Минэкономразвития, Росстата или ведомственной инструкции (например, для госзадания, KPI, статистической отчетности)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых случаев расчета удельных показателей нарастающим итогом (например, сезонность, пересчет базовых значений)."
      }
    ],
