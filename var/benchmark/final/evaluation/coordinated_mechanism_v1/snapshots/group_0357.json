  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить субъекты (подписантов) соглашения о реализации регионального проекта в рамках нацпроектов или госпрограмм РФ. Требуется найти нормативный акт, регламентирующий порядок подписания таких соглашений (обычно это Минэкономразвития РФ и субъект РФ)."
      },
      {
        "id": "A2",
        "need": "Выявить должностных лиц, уполномоченных подписывать соглашение от имени Правительства РФ (или Минэкономразвития) и от имени субъекта РФ (Губернатор/Глава региона или уполномоченный орган)."
      },
      {
        "id": "A3",
        "need": "Проверить наличие исключений или особых случаев (например, соглашения с городами федерального значения, автономными округами, или соглашения в рамках конкретных нацпроектов, где могут быть иные правила)."
      },
      {
        "id": "A4",
        "need": "Найти точные ссылки на нормативные правовые акты (Постановления Правительства РФ), регулирующие форму и порядок подписания соглашений о реализации региональных проектов."
      }
    ],
    "assignments": {
      "bm25": [
        "соглашение о реализации регионального проекта",
        "Постановление Правительства РФ от 01.12.2020 № 2012"
      ],
