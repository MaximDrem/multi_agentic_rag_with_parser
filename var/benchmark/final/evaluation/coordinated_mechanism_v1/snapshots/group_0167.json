  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий порядок разработки и утверждения Единого плана (государственного задания или плана работы) для государственных (муниципальных) учреждений."
      },
      {
        "id": "A2",
        "need": "Выявить правило, касающееся частоты внесения изменений в утверждаемую часть Единого плана (например, один раз в год, в течение года, при изменении законодательства)."
      },
      {
        "id": "A3",
        "need": "Уточнить, относится ли правило к федеральным, региональным или муниципальным учреждениям, так как регламенты могут отличаться (например, Постановление Правительства РФ № 1007 для федеральных казенных учреждений или аналогичные акты для других типов)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых процедур внесения изменений (например, внеплановые изменения)."
      }
    ],
