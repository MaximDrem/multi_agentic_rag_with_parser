  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий работу Системы видеонаблюдения и контроля (СВПО) в контексте обработки данных об автоинцидентах (например, Постановление Правительства РФ № 1416 или ведомственные приказы МВД/Минтранса)."
      },
      {
        "id": "A2",
        "need": "Выявить процедуру или технические регламенты загрузки данных в СВПО, специфичные именно для 'автоинцидентов' (автоматически зарегистрированных инцидентов)."
      },
      {
        "id": "A3",
        "need": "Идентифицировать три конкретных этапа (стадии) этого процесса загрузки (например: сбор/фиксация, передача/синхронизация, обработка/хранение)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых условий для этапов загрузки (например, автоматический режим vs ручной, временные рамки)."
      }
    ],
    "assignments": {
      "bm25": [
        "СВПО",
        "автоинциденты"
      ],
      "dense": [
        "этапы загрузки данных в систему видеонаблюдения для автоинцидентов",
        "процедура передачи данных СВПО при автоматической фиксации нарушений"
      ]
    }
  },
