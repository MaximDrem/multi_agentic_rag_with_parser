  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регламентирующий деятельность проектного офиса Правительства РФ и порядок взаимодействия с группами поддержки (или аналогичными рабочими группами/подгруппами)."
      },
      {
        "id": "A2",
        "need": "Выявить конкретные критерии, условия или триггеры, при которых руководитель группы поддержки обязан или имеет право инициировать эскалацию запроса в проектный офис."
      },
      {
        "id": "A3",
        "need": "Определить процессуальные сроки или этапы, на которых происходит принятие такого решения (например, истечение сроков рассмотрения на нижнем уровне, отсутствие результата, наличие рисков)."
      },
      {
        "id": "A4",
        "need": "Уточнить статус 'руководителя группы поддержки' в контексте данной процедуры: является ли это официальной должностью или функциональной ролью в рамках конкретного поручения/распоряжения."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений или альтернативных путей эскалации, если таковые предусмотрены регламентом."
      }
    ],
    "assignments": {
      "bm25": [
        "проектный офис Правительства РФ",
        "группа поддержки"
      ],
      "dense": [
        "условия эскалации запроса в проектный офис Правительства РФ",
        "критерии передачи дела из группы поддержки в проектный офис"
      ]
    }
  },
