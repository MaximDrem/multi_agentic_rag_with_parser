  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативное определение термина «менеджер инцидентов» в контексте средств защиты информации (СЗИ) и систем управления инцидентами информационной безопасности (SIEM/СЗИ ИБ). Уточнить, является ли этот термин обязательным требованием ФСТЭК/ФСБ или внутренним понятием."
      },
      {
        "id": "A2",
        "need": "Выявить функции, обязанности и зону ответственности менеджера инцидентов согласно требованиям к построению систем обнаружения и предотвращения вторжений (СОВ/СППВ) и системам управления событиями информационной безопасности (СЗИ ИБ/СЗИ ИБ)."
      },
      {
        "id": "A3",
        "need": "Проверить наличие требований к квалификации, правам и взаимодействию с другими подразделениями (администраторы СЗИ, служба безопасности, руководство) в рамках регламентов реагирования на инциденты ИБ."
      },
      {
        "id": "A4",
        "need": "Определить, относится ли термин к конкретным типам СВПО (например, СЗИ от несанкционированного доступа, антивирусная защита, межсетевые экраны) или к комплексным системам управления ИБ."
      }
    ],
    "assignments": {
      "bm25": [
        "менеджер инцидентов",
        "СЗИ от НСД"
      ],
      "dense": [
        "функции менеджера инцидентов информационной безопасности",
        "обязанности специалиста по реагированию на инциденты ИБ"
      ]
    }
  },
