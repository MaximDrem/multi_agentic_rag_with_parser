    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный правовой акт, регламентирующий порядок подачи и рассмотрения единого запроса (запроса на изменение) в Минэкономразвития России."
      },
      {
        "id": "A2",
        "need": "Выявить перечень объектов (предметов), на которые распространяется процедура рассмотрения единого запроса (например, проекты нормативных правовых актов, стандарты, технические регламенты и т.д.)."
      },
      {
        "id": "A3",
        "need": "Уточнить, что понимается под «единым запросом» и «запросом на изменение» в контексте данного ведомства (субъекты обращения, форма подачи)."
      },
      {
        "id": "A4",
        "need": "Определить сроки и порядок рассмотрения таких запросов, а также основания для отказа или удовлетворения."
      }
    ],
