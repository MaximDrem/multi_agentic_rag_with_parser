  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регламентирующий деятельность Аналитического центра при Правительстве РФ (или его предшественника/аналога в контексте СВПО) и порядок классификации запросов."
      },
      {
        "id": "A2",
        "need": "Выявить конкретные три классификационных признака, используемых для первичной классификации запросов в Системе взаимодействия с общественностью (СВПО) или аналогичной информационной системе."
      },
      {
        "id": "A3",
        "need": "Установить, кто именно является 'специалистами Аналитического центра' в контексте обработки этих запросов (должностное лицо, отдел, подразделение)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или дополнительных условий классификации (например, срочность, конфиденциальность, тематика)."
      },
      {
        "id": "A5",
        "need": "Определить актуальность нормативного акта (даты вступления в силу, действующая редакция)."
      }
    ],
    "assignments": {
      "bm25": [
        "СВПО",
        "Аналитический центр при Правительстве РФ"
      ],
      "dense": [
        "классификация запросов Аналитический центр Правительство РФ признаки",
        "первичная классификация обращений в СВПО"
      ]
    }
  },
