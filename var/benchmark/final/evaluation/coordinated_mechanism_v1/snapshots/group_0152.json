  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определение понятия «Единый план» (ЕП) в контексте государственного управления или корпоративного управления, так как термин не является универсальным юридическим понятием без привязки к отрасли."
      },
      {
        "id": "A2",
        "need": "Выявление нормативных правовых актов (НПА), в которых закреплено понятие «Единый план» и перечислены инструменты его достижения (например, Единый план государственного регулирования деятельности юридических лиц, Единый план антикоррупционных мероприятий, Единый план работы Правительства РФ и т.д.)."
      },
      {
        "id": "A3",
        "need": "Анализ конкретных механизмов, методов и средств (инструментов), предусмотренных соответствующим НПА для реализации целей Единого плана (например, мониторинг, отчетность, согласование, контроль, финансирование, нормотворческая деятельность)."
      },
      {
        "id": "A4",
        "need": "Определение органов, ответственных за использование данных инструментов и контроль за исполнением Единого плана."
      },
      {
        "id": "A5",
        "need": "Установление периодичности и порядка формирования, утверждения и корректировки Единого плана, так как это влияет на выбор инструментов."
      }
    ],
    "assignments": {
