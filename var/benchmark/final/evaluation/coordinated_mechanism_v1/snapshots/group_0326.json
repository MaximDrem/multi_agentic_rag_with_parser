  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативную базу, регулирующую процесс строительства и ввода в эксплуатацию объектов недвижимости в РФ (Градостроительный кодекс РФ, Постановления Правительства РФ о строительстве)."
      },
      {
        "id": "A2",
        "need": "Выявить наличие требования о генерации QR-кодов именно на паспортах строящихся объектов. Проверить, существует ли документ с названием 'паспорт строящегося объекта' и является ли он обязательным."
      },
      {
        "id": "A3",
        "need": "Определить, кто уполномочен генерировать QR-коды (орган исполнительной власти, застройщик, технический заказчик) и на каких этапах строительства это происходит."
      },
      {
        "id": "A4",
        "need": "Установить технический стандарт или формат QR-кода, если он регламентирован (содержание данных, алгоритм генерации, интеграция с государственными информационными системами, такими как ЕГРН или ГИС ЖКХ)."
      },
      {
        "id": "A5",
        "need": "Проверить исключения или альтернативные требования (например, использование электронных паспортов, маркировка через другие системы, отсутствие QR-кодов на текущий момент)."
      },
      {
        "id": "A6",
        "need": "Определить даты вступления в силу соответствующих нормативных актов, регулирующих использование QR-кодов в строительной документации."
      }
    ],
    "assignments": {
