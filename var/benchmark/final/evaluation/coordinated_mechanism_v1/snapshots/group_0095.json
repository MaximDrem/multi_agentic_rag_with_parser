  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий порядок рассмотрения обращений граждан и организаций в государственных органах РФ (например, ФЗ-59 или ведомственные регламенты)."
      },
      {
        "id": "A2",
        "need": "Выявить стандартный срок рассмотрения обращения (обычно 30 дней)."
      },
      {
        "id": "A3",
        "need": "Найти условия, при которых срок может быть продлен (необходимость дополнительных проверок, запрос документов и т.д.)."
      },
      {
        "id": "A4",
        "need": "Определить максимальный срок продления (обычно до 30 дней, итого до 60 дней, но проверить исключения для конкретных ведомств)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений для отдельных категорий обращений или ведомств (например, МВД, ФНС, Роспотребнадзор), где сроки могут отличаться."
      },
      {
        "id": "A6",
        "need": "Уточнить процедуру уведомления заявителя о продлении срока."
      }
    ],
    "assignments": {
      "bm25": [
        "Федеральный закон от 02.05.2006 N 59-ФЗ \"О порядке рассмотрения обращений граждан Российской Федерации\"",
        "статья 33.1 ФЗ-59 продление срока"
      ],
      "dense": [
        "максимальный срок продления рассмотрения обращения гражданина",
        "продление срока ответа на жалобу в госорганах"
      ]
    }
  },
