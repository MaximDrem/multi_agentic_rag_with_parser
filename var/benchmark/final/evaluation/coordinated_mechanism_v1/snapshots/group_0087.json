  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий порядок рассмотрения обращений граждан и организаций в РФ (Федеральный закон № 59-ФЗ), так как именно он устанавливает общие требования к ответам на запросы."
      },
      {
        "id": "A2",
        "need": "Проверить наличие в Федеральном законе № 59-ФЗ или подзаконных актах (например, приказах Минюста или ГОСТах) конкретных шкал оценки (например, балльных, качественных: удовлетворен/не удовлетворен) для оценки качества ответа заявителем."
      },
      {
        "id": "A3",
        "need": "Выяснить, является ли оценка ответа заявителем обязательной процедурой или же она носит рекомендательный характер (например, через обратную связь, опросы удовлетворенности)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие специальных отраслевых нормативных актов (например, в сфере госуслуг, налоговых органов, правоохранительных структур), которые могут устанавливать свои критерии оценки ответов."
      },
      {
        "id": "A5",
        "need": "Определить, существует ли механизм подачи жалобы на ответ, который фактически заменяет или дополняет процедуру оценки, и какие критерии используются при рассмотрении таких жалоб."
      }
    ],
    "assignments": {
      "bm25": [
        "Федеральный закон от 02.05.2006 N 59-ФЗ",
        "оценка качества ответа"
      ],
      "dense": [
