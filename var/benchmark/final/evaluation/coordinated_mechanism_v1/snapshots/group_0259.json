    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативное понятие 'УД' (удаленная работа, удаленный доступ, удостоверение личности, уголовно-деловое производство?) в контексте 'РП' (руководитель проекта, районный прокурор, реестр прав, робот-программист?). Без уточнения аббревиатур вопрос некорректен."
      },
      {
        "id": "A2",
        "need": "Если 'УД' = 'удаленная работа', а 'РП' = 'работник' (опечатка) или 'работодатель': найти сроки фиксации факта удаленной работы в трудовом договоре или дополнительных соглашениях согласно ТК РФ."
      },
      {
        "id": "A3",
        "need": "Если 'УД' = 'удостоверение личности', а 'РП' = 'регистрационный учет': найти сроки фиксации регистрации по месту пребывания/ жительства (прописки) согласно Постановлению Правительства РФ №713."
      },
      {
        "id": "A4",
        "need": "Если 'УД' = 'уголовное дело', а 'РП' = 'районный прокурор': найти сроки фиксации (возбуждения, регистрации) уголовного дела в порядке УПК РФ."
      },
      {
        "id": "A5",
        "need": "Проверить наличие специфических отраслевых нормативных актов, где используются аббревиатуры 'УД' и 'РП' (например, в IT-секторе, госзакупках, банковской сфере)."
      }
    ],
