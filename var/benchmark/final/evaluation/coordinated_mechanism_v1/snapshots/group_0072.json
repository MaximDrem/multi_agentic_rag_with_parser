  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий деятельность проектных комитетов (ПК) в РФ (например, Постановление Правительства РФ № 1078 или отраслевые акты)."
      },
      {
        "id": "A2",
        "need": "Найти конкретную норму, устанавливающую срок направления протокола заседания проектного комитета его членам и иным участникам."
      },
      {
        "id": "A3",
        "need": "Уточнить, с какого момента исчисляется данный срок (с даты проведения заседания, с даты подписания протокола и т.д.)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых правил для разных видов проектных комитетов (федеральные, региональные, отраслевые)."
      }
    ],
    "assignments": {
      "bm25": [
        "Протокол заседания проектного комитета",
