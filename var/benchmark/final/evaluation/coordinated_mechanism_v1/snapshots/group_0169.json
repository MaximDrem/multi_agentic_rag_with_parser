  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регулирующий деятельность Общественно-экспертного совета (ОЭС) при Минэкономразвития России (или ином уполномоченном органе), в частности, положения о порядке его работы и сроках рассмотрения предложений."
      },
      {
        "id": "A2",
        "need": "Выяснить, что такое 'Единый план' (вероятно, Единый план мероприятий по реализации государственной политики в сфере защиты прав потребителей или Единый план проверок, но контекст 'изменения' и 'ОЭС' указывает на конкретную процедуру, например, в сфере стандартизации или госзакупок). Уточнить название документа."
      },
      {
        "id": "A3",
        "need": "Найти конкретную норму, устанавливающую срок (в днях/рабочих днях), в течение которого ОЭС должен сформировать позицию (заключение, мнение) по предложению об изменении указанного плана."
      },
      {
        "id": "A4",
        "need": "Определить момент начала исчисления срока (с даты получения предложения, с даты публикации, с даты заседания и т.д.)."
      },
      {
        "id": "A5",
        "need": "Проверить наличие исключений или особых процедур (например, упрощенный порядок, срочные случаи), влияющих на срок."
      }
    ],
    "assignments": {
      "bm25": [
        "Общественно-экспертный совет",
        "Единый план"
      ],
