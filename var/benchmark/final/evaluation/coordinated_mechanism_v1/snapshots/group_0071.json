  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий деятельность проектных комитетов (ПК) в РФ (например, Постановление Правительства РФ № 1231 или региональные акты, если ПК создаются на уровне субъекта, но чаще всего речь идет о федеральном уровне или типовых регламентах). Уточнить, существует ли единый федеральный закон о проектных комитетах или это институт государственно-частного партнерства (ГЧП) / концессий."
      },
      {
        "id": "A2",
        "need": "Найти положения о порядке принятия решений проектного комитета, в частности, регламент работы в заочной форме (письменный опрос). Определить, кто устанавливает сроки: закон, договор ГЧП/концессии или внутренний регламент ПК."
      },
      {
        "id": "A3",
        "need": "Выявить конкретные сроки для заочного голосования. Если срок не фиксирован федеральным законом напрямую, определить, является ли он предметом договорных отношений или регламента конкретного ПК, и есть ли типовые рекомендации."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых случаев (например, срочные вопросы, вопросы безопасности), где сроки могут отличаться."
      }
    ],
    "assignments": {
      "bm25": [
        "Постановление Правительства РФ от 22.12.2009 N 1231",
        "ФЗ-224 ГЧП"
      ],
      "dense": [
        "сроки принятия решений проектного комитета заочное голосование",
        "регламент проектного комитета письменный опрос срок"
      ]
    }
  },
