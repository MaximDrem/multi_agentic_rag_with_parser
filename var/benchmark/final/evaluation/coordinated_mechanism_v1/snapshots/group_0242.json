  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определение понятия 'автоинцидент' в контексте нормативных правовых актов РФ (если такое понятие закреплено законодательно или в отраслевых стандартах, например, в сфере страхования, дорожного движения или кибербезопасности)."
      },
      {
        "id": "A2",
        "need": "Перечень субъектов (участников), вовлеченных в процесс выявления, регистрации, расследования и урегулирования автоинцидентов. Это могут быть: страховые компании, автовладельцы, ГИБДД, технические эксперты, ремонтные организации, IT-операторы (если инцидент касается автономного вождения или телематики)."
      },
      {
        "id": "A3",
        "need": "Правовые основания (законы, постановления, приказы, ГОСТы), регулирующие порядок взаимодействия указанных участников при возникновении автоинцидентов."
      },
      {
        "id": "A4",
        "need": "Разграничение ролей и обязанностей каждого участника в процессе управления инцидентом (кто инициирует, кто фиксирует, кто принимает решение, кто компенсирует ущерб)."
      },
      {
        "id": "A5",
        "need": "Специфика участников в зависимости от типа автоинцидента (ДТП, техническая неисправность, кибератака на транспортное средство, ошибка алгоритма)."
      }
    ],
    "assignments": {
      "bm25": [
        "Федеральный закон об ОСАГО",
        "Правила дорожного движения РФ"
      ],
      "dense": [
        "кто участвует в процессе управления автоинцидентами",
        "субъекты процесса урегулирования автоинцидентов"
      ]
    }
  },
