  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, устанавливающий порядок расчета УДЕП (Уровень достижения Единого плана). Обычно это Приказы Минэкономразвития РФ или Постановления Правительства РФ о планировании."
      },
      {
        "id": "A2",
        "need": "Найти точную формулу или методические указания по расчету УДЕП. Искать термины: 'формула расчета', 'коэффициент', 'индекс', 'УДЕП', 'единый план', 'целевые показатели'."
      },
      {
        "id": "A3",
        "need": "Выявить компоненты формулы: что является числителем (факт, план, отклонение), что знаменателем, какие коэффициенты применяются (весовые, корректирующие)."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых случаев расчета (например, для отдельных ведомств, при форс-мажоре, при изменении плана)."
      },
      {
        "id": "A5",
        "need": "Установить актуальность формулы (дата вступления в силу нормативного акта, действующая редакция)."
      }
    ],
    "assignments": {
      "bm25": [
        "Приказ Минэкономразвития России",
        "Постановление Правительства РФ"
      ],
      "dense": [
        "методика расчета уровня достижения единого плана",
        "формула расчета УДЕП министерства"
      ]
    }
  },
