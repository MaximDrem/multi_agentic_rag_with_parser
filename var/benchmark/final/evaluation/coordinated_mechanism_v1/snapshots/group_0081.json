  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный акт, регулирующий сроки ответов на запросы информации (например, ФЗ-8, ФЗ-59, ведомственные регламенты или ГОСТы по информационной безопасности/отчетности)."
      },
      {
        "id": "A2",
        "need": "Найти классификацию запросов по уровню срочности (высокая, стандартная, низкая) и соответствующие им контрольные сроки (в днях/часах)."
      },
      {
        "id": "A3",
        "need": "Выявить исключения или особые условия, влияющие на сроки (например, необходимость согласования, запрос в другие органы, конфиденциальность)."
      },
      {
        "id": "A4",
        "need": "Определить, относится ли термин «запрос информации» к конкретному ведомству (ФНС, Росстат, Минцифры, банки) или это общий термин, требующий уточнения контекста."
      }
    ],
    "assignments": {
      "bm25": [
        "ФЗ № 8-ФЗ «Об информации, информационных технологиях и о защите информации»",
        "ФЗ № 59-ФЗ «О порядке рассмотрения обращений граждан РФ»"
      ],
      "dense": [
        "сроки ответов на запросы информации классификация срочности",
        "контрольные сроки обработки запросов высокой стандартной низкой срочности"
      ]
    }
  },
