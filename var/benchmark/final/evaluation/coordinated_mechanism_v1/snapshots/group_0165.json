  "plan": {
    "aspects": [
      {
        "id": "A1",
        "need": "Определить нормативный документ, регламентирующий порядок реагирования на инциденты в рамках Единого плана (вероятно, речь идет о Едином плане ликвидации аварий (ЕПЛА) или аналогичных планах в сфере промышленной безопасности, гражданской обороны или ЧС)."
      },
      {
        "id": "A2",
        "need": "Найти конкретную норму, устанавливающую временные рамки (срок) для реализации мер реагирования ответственным исполнителем после получения информации об инциденте."
      },
      {
        "id": "A3",
        "need": "Уточнить, кто считается 'ответственным исполнителем' в контексте данного документа и какие именно 'меры реагирования' подразумеваются."
      },
      {
        "id": "A4",
        "need": "Проверить наличие исключений или особых условий, влияющих на срок (например, класс опасности, тип инцидента)."
      }
    ],
    "assignments": {
      "bm25": [
        "Единый план ликвидации аварий",
        "ЕПЛА"
      ],
      "dense": [
        "срок реализации мер реагирования инцидент Единый план",
        "время реакции на инцидент ответственный исполнитель"
      ]
    }
  },
